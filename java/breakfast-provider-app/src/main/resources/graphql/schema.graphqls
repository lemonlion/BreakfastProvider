type Query {
    orderSummaries: [OrderSummary!]!
    popularRecipes: [RecipeTypeCount!]!
    ingredientShipments: [IngredientShipment!]!
}

type OrderSummary {
    orderId: ID!
    customerName: String!
    itemCount: Int!
    tableNumber: Int
    status: String!
    createdAt: String!
}

type RecipeTypeCount {
    recipeType: String!
    count: Int!
}

type IngredientShipment {
    deliveryId: ID!
    ingredientName: String!
    quantity: Float!
    deliveredAt: String!
}
