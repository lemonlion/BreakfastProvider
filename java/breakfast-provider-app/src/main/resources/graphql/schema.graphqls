type Query {
    orderSummaries: [OrderSummary!]!
    popularRecipes: [RecipeTypeCount!]!
    ingredientShipments: [IngredientShipment!]!
    batchCompletions: [BatchCompletion!]!
    equipmentAlerts: [EquipmentAlert!]!
    recipeReports: [RecipeReport!]!
    ingredientUsage: [IngredientUsage!]!
}

type OrderSummary {
    orderId: ID!
    customerName: String!
    itemCount: Int!
    tableNumber: Int
    status: String!
    createdAt: String!
}

type RecipeTypeCount {
    recipeType: String!
    count: Int!
}

type IngredientShipment {
    deliveryId: ID!
    ingredientName: String!
    quantity: Float!
    deliveredAt: String!
}

type BatchCompletion {
    batchId: ID!
    recipeType: String!
    completedAt: String!
}

type EquipmentAlert {
    alertId: ID!
    batchId: ID!
    equipmentName: String!
    alertType: String!
    alertedAt: String!
}

type RecipeReport {
    orderId: ID!
    recipeType: String!
    ingredients: String!
    toppings: String!
    loggedAt: String!
}

type IngredientUsage {
    ingredient: String!
    count: Int!
}
