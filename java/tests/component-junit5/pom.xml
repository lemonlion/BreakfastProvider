<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.lemonlion.breakfast</groupId>
        <artifactId>breakfast-provider-java-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>breakfast-provider-tests-component-junit5</artifactId>
    <name>Breakfast Provider (Java) — Component Tests (JUnit 5)</name>
    <description>Component-test suite driven by JUnit 5, reported via kronikol4j-junit5.</description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Surefire discovers the Kronikol4J LauncherSessionListener via this launcher on the test classpath. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Shared component-test infrastructure (Testcontainers backends, client, steps) + the SUT. -->
        <dependency>
            <groupId>io.lemonlion.breakfast</groupId>
            <artifactId>breakfast-provider-tests-component-shared</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Kronikol4J: JUnit 5 adapter (identity scoping + report finalization). -->
        <dependency>
            <groupId>io.kronikol</groupId>
            <artifactId>kronikol4j-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Kronikol4J CLI (+ transitive report/diagram/jackson) for the merge step. -->
        <dependency>
            <groupId>io.kronikol</groupId>
            <artifactId>kronikol4j-cli</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- Inherits forkCount/reuseForks and the kronikol.run.dir system property from the parent. -->
            </plugin>

            <!-- Ensure the report output directory exists before the CLI merge writes into it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>kronikol-report-dir</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${kronikol.report.dir}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- After tests, merge this module's report fragments into target/Reports/TestRunReport.html. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>kronikol-merge-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <!-- Fork a separate JVM: the CLI calls System.exit, which under exec:java
                                 would terminate the Maven reactor (skipping later modules). -->
                            <executable>${java.home}/bin/java</executable>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>io.kronikol.cli.Main</argument>
                                <argument>merge</argument>
                                <argument>${kronikol.fragments.dir}</argument>
                                <argument>-o</argument>
                                <argument>${kronikol.report.dir}/TestRunReport.html</argument>
                                <argument>-t</argument>
                                <argument>Breakfast Provider (JUnit 5)</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
