<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.lemonlion.breakfast</groupId>
        <artifactId>breakfast-provider-java-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>breakfast-provider-tests-component-spock</artifactId>
    <name>Breakfast Provider (Java) — Component Tests (Spock)</name>
    <description>Groovy/Spock component-test suite on the JUnit Platform, reported via kronikol4j-spock.</description>

    <dependencies>
        <dependency>
            <groupId>io.lemonlion.breakfast</groupId>
            <artifactId>breakfast-provider-tests-component-shared</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Spock + Groovy on the JUnit Platform. -->
        <dependency>
            <groupId>org.spockframework</groupId>
            <artifactId>spock-core</artifactId>
            <version>${spock.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.spockframework</groupId>
            <artifactId>spock-spring</artifactId>
            <version>${spock.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>${groovy.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Kronikol4J: Spock global extension (identity scoping) + the JUnit Platform listener that
             finalizes the report fragment at session close (Spock runs on the JUnit Platform) + CLI. -->
        <dependency>
            <groupId>io.kronikol</groupId>
            <artifactId>kronikol4j-spock</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.kronikol</groupId>
            <artifactId>kronikol4j-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.kronikol</groupId>
            <artifactId>kronikol4j-cli</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spock specs are named *Spec, which Surefire's default include patterns miss. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Spec.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!-- Compile Groovy/Spock specs. -->
            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <version>4.1.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>compileTests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>kronikol-report-dir</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${kronikol.report.dir}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>kronikol-merge-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <!-- Fork a separate JVM: the CLI calls System.exit, which under exec:java
                                 would terminate the Maven reactor (skipping later modules). -->
                            <executable>${java.home}/bin/java</executable>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>-classpath</argument>
                                <!-- Scope to the CLI's own dependency tree so the forked java command line
                                     stays under the Windows length limit (the full test classpath is huge). -->
                                <classpath>
                                    <dependency>io.kronikol:kronikol4j-cli</dependency>
                                    <dependency>io.kronikol:kronikol4j-report</dependency>
                                    <dependency>io.kronikol:kronikol4j-diagram</dependency>
                                    <dependency>io.kronikol:kronikol4j-core</dependency>
                                </classpath>
                                <argument>io.kronikol.cli.Main</argument>
                                <argument>merge</argument>
                                <argument>${kronikol.fragments.dir}</argument>
                                <argument>-o</argument>
                                <argument>${kronikol.report.dir}/TestRunReport.html</argument>
                                <argument>-t</argument>
                                <argument>Breakfast Provider (Spock)</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
