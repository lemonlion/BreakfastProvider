<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.lemonlion.breakfast</groupId>
        <artifactId>breakfast-provider-java-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>breakfast-provider-tests-component-testng</artifactId>
    <name>Breakfast Provider (Java) — Component Tests (TestNG)</name>
    <description>Component-test suite driven by TestNG, reported via kronikol4j-testng.</description>

    <dependencies>
        <dependency>
            <groupId>io.lemonlion.breakfast</groupId>
            <artifactId>breakfast-provider-tests-component-shared</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Kronikol4J: TestNG adapter (identity scoping + report finalization via ServiceLoader). -->
        <dependency>
            <groupId>io.kronikol</groupId>
            <artifactId>kronikol4j-testng</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.kronikol</groupId>
            <artifactId>kronikol4j-cli</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- Force the TestNG provider: spring-boot-starter-test also drags in JUnit, and we
                     must not let the JUnit Platform provider silently ignore the TestNG tests. -->
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-testng</artifactId>
                        <version>${surefire.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>kronikol-report-dir</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${kronikol.report.dir}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>kronikol-merge-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <classpathScope>test</classpathScope>
                            <mainClass>io.kronikol.cli.Main</mainClass>
                            <arguments>
                                <argument>merge</argument>
                                <argument>${kronikol.fragments.dir}</argument>
                                <argument>-o</argument>
                                <argument>${kronikol.report.dir}/TestRunReport.html</argument>
                                <argument>-t</argument>
                                <argument>Breakfast Provider (TestNG)</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
